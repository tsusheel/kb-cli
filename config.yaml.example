# Knowledge Base (kb) Configuration File
# Location: ~/.config/kb/config.yaml

# Application Identifier
app_name: "kb-app"

# Base directory where kb.db and data files are stored (defaults to ~/.config/kb)
base_path: "~/.config/kb"

# Preferred default date format for parsing / display
date_format: "2006-01-02"

# Remote PostgreSQL Synchronization Settings
# Note: Sensitive database passwords are NEVER saved in plaintext here.
# They are stored securely in your OS Credential Manager (Windows Credential Manager / macOS Keychain / Linux Secret Service).
# Configure interactively via: kb config setup
remote:
  enabled: true
  provider: "postgres"
  postgres_url: "postgres://username@localhost:5432/dbname?sslmode=disable"
